---
// This page belongs to ONE participant. Edit freely — it is fully self-contained.
export const title = 'Dashboard';

import Base from '../../layouts/Base.astro';
import Stat from '../../components/ui/Stat.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
---

<Base title={title} description="An at-a-glance summary of everything going on.">
  <header class="mb-8">
    <h1 class="text-3xl font-semibold tracking-tight">Dashboard</h1>
    <p class="mt-2 text-slate-600">An at-a-glance summary of everything going on today.</p>
  </header>

  <div class="grid gap-4 sm:grid-cols-3">
    <Stat label="Active users" value="2,481" change="+8.2%" trend="up" hint="vs. last week" />
    <Stat label="Open tickets" value="37" change="-12%" trend="down" hint="vs. last week" />
    <Stat label="Uptime" value="99.9%" change="stable" trend="flat" hint="last 30 days" />
  </div>

  <Card class="mt-6">
    <span slot="title">Today's focus</span>
    <span slot="description">Three things worth your attention</span>

    <ul class="space-y-3">
      <li class="flex items-center justify-between gap-4">
        <span>Review the new onboarding flow</span>
        <Badge variant="warning">In review</Badge>
      </li>
      <li class="flex items-center justify-between gap-4">
        <span>Ship the September release notes</span>
        <Badge variant="success">Ready</Badge>
      </li>
      <li class="flex items-center justify-between gap-4">
        <span>Plan next quarter's roadmap</span>
        <Badge>Not started</Badge>
      </li>
    </ul>

    <div slot="footer">
      <Button size="sm" href="/app/tasks">Open tasks</Button>
      <Button size="sm" variant="ghost">Dismiss</Button>
    </div>
  </Card>
</Base>
