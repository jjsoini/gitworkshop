---
export const title = 'Entertainment';

import Base from '../../layouts/Base.astro';
import Button from '../../components/ui/Button.astro';
import Stat from '../../components/ui/Stat.astro';
---

<Base title={title} description="Take a break with a classic worm game.">
  <header class="mb-8">
    <h1 class="text-3xl font-semibold tracking-tight">Entertainment</h1>
    <p class="mt-2 text-slate-600">
      A Nokia-style worm game. Eat the food, grow longer, don't bite yourself.
    </p>
  </header>

  <div class="grid gap-6 lg:grid-cols-[auto_1fr]">
    <div class="h-fit w-fit rounded-2xl bg-slate-800 p-2.5 shadow-lg">
      <div class="rounded border-2 border-slate-900 bg-[#c7d9a6] p-1">
        <div class="mb-0.5 flex justify-between font-mono text-[9px] font-bold leading-tight text-[#2b3a1f]">
          <span id="worm-score">0000</span>
          <span id="worm-status">PRESS START</span>
        </div>
        <canvas
          id="worm-canvas"
          width="336"
          height="224"
          class="block w-[168px] border border-[#2b3a1f]"
          aria-label="Worm game board"></canvas>
      </div>

      <div class="mt-2.5 flex items-center justify-between gap-2">
        <div class="grid grid-cols-3 gap-0.5" aria-label="Direction controls">
          <span></span>
          <button data-dir="up" class="worm-key" aria-label="Up">▲</button>
          <span></span>
          <button data-dir="left" class="worm-key" aria-label="Left">◀</button>
          <span></span>
          <button data-dir="right" class="worm-key" aria-label="Right">▶</button>
          <span></span>
          <button data-dir="down" class="worm-key" aria-label="Down">▼</button>
          <span></span>
        </div>
        <Button id="worm-start" variant="secondary" size="sm" class="!h-6 !px-2 !text-xs">Start</Button>
      </div>
    </div>

    <div class="space-y-4">
      <div class="grid gap-4 sm:grid-cols-2">
        <div id="worm-stat-score"><Stat label="Score" value="0" /></div>
        <div id="worm-stat-high"><Stat label="High score" value="0" /></div>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-5 text-sm text-slate-600 shadow-sm">
        <h2 class="mb-2 text-base font-semibold text-slate-900">How to play</h2>
        <ul class="list-disc space-y-1 pl-5">
          <li>Arrow keys or WASD to steer (or the on-screen buttons).</li>
          <li>Space to start and pause.</li>
          <li>Each bite is worth 10 points, and the worm speeds up as it grows.</li>
          <li>The worm wraps around the edges, but running into itself ends the game.</li>
        </ul>
      </div>
    </div>
  </div>
</Base>

<style>
  .worm-key {
    height: 1.25rem;
    width: 1.25rem;
    border-radius: 9999px;
    background: #0f172a;
    color: #cbd5e1;
    font-size: 0.5rem;
    cursor: pointer;
  }
  .worm-key:active {
    background: #334155;
  }
</style>

<script>
  const COLS = 24;
  const ROWS = 16;
  const CELL = 14;
  const INK = '#2b3a1f';
  const LCD = '#c7d9a6';

  const canvas = document.getElementById('worm-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const scoreEl = document.getElementById('worm-score')!;
  const statusEl = document.getElementById('worm-status')!;
  const startBtn = document.getElementById('worm-start')!;
  // Stat doesn't take an id, so each one is wrapped; the big number is its .text-3xl paragraph.
  const statValue = (id: string) =>
    document.querySelector<HTMLElement>(`#${id} .text-3xl`) ?? undefined;
  const statScore = statValue('worm-stat-score');
  const statHigh = statValue('worm-stat-high');

  type Point = { x: number; y: number };
  type Dir = 'up' | 'down' | 'left' | 'right';
  const VEC: Record<Dir, Point> = {
    up: { x: 0, y: -1 },
    down: { x: 0, y: 1 },
    left: { x: -1, y: 0 },
    right: { x: 1, y: 0 },
  };
  const OPPOSITE: Record<Dir, Dir> = { up: 'down', down: 'up', left: 'right', right: 'left' };

  let worm: Point[] = [];
  let dir: Dir = 'right';
  let queue: Dir[] = [];
  let food: Point = { x: 0, y: 0 };
  let score = 0;
  let state: 'idle' | 'running' | 'paused' | 'over' = 'idle';
  let timer: number | undefined;

  let high = 0;
  try {
    high = Number(localStorage.getItem('worm-high') ?? 0) || 0;
  } catch {}

  function reset() {
    worm = [
      { x: 6, y: 8 },
      { x: 5, y: 8 },
      { x: 4, y: 8 },
      { x: 3, y: 8 },
    ];
    dir = 'right';
    queue = [];
    score = 0;
    placeFood();
    updateScore();
  }

  function placeFood() {
    do {
      food = { x: Math.floor(Math.random() * COLS), y: Math.floor(Math.random() * ROWS) };
    } while (worm.some((p) => p.x === food.x && p.y === food.y));
  }

  function speed() {
    return Math.max(60, 150 - Math.floor(score / 50) * 10);
  }

  function updateScore() {
    scoreEl.textContent = String(score).padStart(4, '0');
    if (statScore) statScore.textContent = String(score);
    if (statHigh) statHigh.textContent = String(high);
  }

  function tick() {
    const next = queue.shift();
    if (next && next !== OPPOSITE[dir]) dir = next;

    const head = worm[0];
    const v = VEC[dir];
    const newHead = {
      x: (head.x + v.x + COLS) % COLS,
      y: (head.y + v.y + ROWS) % ROWS,
    };

    const eating = newHead.x === food.x && newHead.y === food.y;
    // The tail moves away this tick unless we're eating, so it's safe to step onto it.
    const body = eating ? worm : worm.slice(0, -1);
    if (body.some((p) => p.x === newHead.x && p.y === newHead.y)) {
      gameOver();
      return;
    }

    worm.unshift(newHead);
    if (eating) {
      score += 10;
      if (score > high) {
        high = score;
        try {
          localStorage.setItem('worm-high', String(high));
        } catch {}
      }
      updateScore();
      placeFood();
    } else {
      worm.pop();
    }

    draw();
    timer = window.setTimeout(tick, speed());
  }

  function cell(x: number, y: number) {
    ctx.fillRect(x * CELL + 1, y * CELL + 1, CELL - 2, CELL - 2);
  }

  function draw() {
    ctx.fillStyle = LCD;
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = INK;
    worm.forEach((p) => cell(p.x, p.y));
    // Food: a small diamond, like the original.
    const cx = food.x * CELL + CELL / 2;
    const cy = food.y * CELL + CELL / 2;
    ctx.beginPath();
    ctx.moveTo(cx, cy - 5);
    ctx.lineTo(cx + 5, cy);
    ctx.lineTo(cx, cy + 5);
    ctx.lineTo(cx - 5, cy);
    ctx.closePath();
    ctx.fill();
  }

  function setStatus(text: string, button: string) {
    statusEl.textContent = text;
    startBtn.textContent = button;
  }

  function start() {
    if (state === 'running') {
      clearTimeout(timer);
      state = 'paused';
      setStatus('PAUSED', 'Resume');
      return;
    }
    if (state === 'idle' || state === 'over') reset();
    state = 'running';
    setStatus('', 'Pause');
    draw();
    timer = window.setTimeout(tick, speed());
  }

  function gameOver() {
    state = 'over';
    setStatus('GAME OVER', 'Play again');
    // Blink the worm a few times.
    let blinks = 0;
    const blink = window.setInterval(() => {
      if (blinks % 2 === 0) {
        ctx.fillStyle = LCD;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
      } else {
        draw();
      }
      if (++blinks > 5) clearInterval(blink);
    }, 150);
  }

  function steer(d: Dir) {
    if (state !== 'running') return;
    const last = queue[queue.length - 1] ?? dir;
    if (d !== last && d !== OPPOSITE[last] && queue.length < 3) queue.push(d);
  }

  const KEYS: Record<string, Dir> = {
    ArrowUp: 'up', ArrowDown: 'down', ArrowLeft: 'left', ArrowRight: 'right',
    w: 'up', s: 'down', a: 'left', d: 'right',
  };

  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('input, textarea, [contenteditable]')) return;
    if (e.key === ' ') {
      e.preventDefault();
      start();
      return;
    }
    const d = KEYS[e.key];
    if (d && state === 'running') {
      e.preventDefault();
      steer(d);
    }
  });

  startBtn.addEventListener('click', start);
  document.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((btn) =>
    btn.addEventListener('click', () => steer(btn.dataset.dir as Dir)),
  );

  reset();
  draw();
</script>
