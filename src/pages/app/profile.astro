---
export const title = 'Profile';

import Base from '../../layouts/Base.astro';
import Avatar from '../../components/ui/Avatar.astro';
import Badge from '../../components/ui/Badge.astro';
import Card from '../../components/ui/Card.astro';
import Label from '../../components/ui/Label.astro';
import Textarea from '../../components/ui/Textarea.astro';
import Button from '../../components/ui/Button.astro';

const shield = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
  <circle cx="50" cy="50" r="50" fill="#b91c1c"/>
  <circle cx="50" cy="50" r="40" fill="#fff"/>
  <circle cx="50" cy="50" r="30" fill="#b91c1c"/>
  <circle cx="50" cy="50" r="20" fill="#1e3a8a"/>
  <polygon fill="#fff" points="50,33 54.1,44.3 66.2,44.8 56.7,52.2 60,63.8 50,57 40,63.8 43.3,52.2 33.8,44.8 45.9,44.3"/>
</svg>`;
const avatarSrc = `data:image/svg+xml;utf8,${encodeURIComponent(shield)}`;
const heroSrc = "data:image/jpeg;base64,";
---

<Base title={title} description="Your personal details.">
  <div class="mb-8 overflow-hidden rounded-2xl shadow-lg ring-1 ring-slate-900/10">
    <img src={heroSrc} alt="Captain America" class="block h-64 w-full object-cover object-[center_15%] sm:h-80" />
  </div>

  <header class="mb-8 flex items-center gap-5">
    <Avatar
      name="Captain America"
      size="lg"
      src={avatarSrc}
      class="!h-20 !w-20"
    />
    <div>
      <h1 class="text-3xl font-semibold tracking-tight">Profile</h1>
      <p class="mt-1 flex items-center gap-2 text-slate-600">
        Captain America <Badge variant="success">Active</Badge>
      </p>
    </div>
  </header>

  <Card>
    <span slot="title">About you</span>
    <span slot="description">Shown to everyone in the workspace</span>

    <div class="space-y-1.5">
      <Label for="bio">Short bio</Label>
      <Textarea id="bio" rows={4} placeholder="Tell your team what you work on..."
        >Product designer working on onboarding and growth. Coffee first, then pixels.</Textarea
      >
    </div>

    <div slot="footer">
      <Button size="sm">Update profile</Button>
    </div>
  </Card>
</Base>
