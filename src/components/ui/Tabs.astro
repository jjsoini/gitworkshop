---
/**
 * Tabs — switch between panels. Interactivity is a few lines of vanilla JS below.
 *
 * Props:
 *   tabs: { id: string; label: string }[]
 *
 * Each tab's content goes in a slot named after its id.
 *
 * Example:
 *   <Tabs tabs={[{ id: "overview", label: "Overview" }, { id: "activity", label: "Activity" }]}>
 *     <p slot="overview">Overview content</p>
 *     <p slot="activity">Activity content</p>
 *   </Tabs>
 */
interface Props {
  tabs: { id: string; label: string }[];
  class?: string;
}
const { tabs, class: className = '' } = Astro.props;
---

<div class={className} data-tabs>
  <div class="flex gap-1 border-b border-slate-200" role="tablist">
    {
      tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          data-tab-trigger={tab.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          class="-mb-px cursor-pointer border-b-2 border-transparent px-4 py-2.5 text-sm font-medium text-slate-500 transition-colors hover:text-slate-900 aria-selected:border-slate-900 aria-selected:text-slate-900"
        >
          {tab.label}
        </button>
      ))
    }
  </div>

  {
    tabs.map((tab, i) => (
      <div data-tab-panel={tab.id} role="tabpanel" class="pt-5 text-sm text-slate-700" hidden={i !== 0}>
        <slot name={tab.id} />
      </div>
    ))
  }
</div>

<script>
  // Runs once per page and wires up every <Tabs> on it.
  document.querySelectorAll('[data-tabs]').forEach((root) => {
    const triggers = root.querySelectorAll<HTMLElement>('[data-tab-trigger]');
    const panels = root.querySelectorAll<HTMLElement>('[data-tab-panel]');

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const id = trigger.dataset.tabTrigger;
        triggers.forEach((t) => t.setAttribute('aria-selected', String(t === trigger)));
        panels.forEach((p) => {
          p.hidden = p.dataset.tabPanel !== id;
        });
      });
    });
  });
</script>
