---
/**
 * Breadcrumb — the trail of links above a page heading.
 *
 * Props:
 *   items: { label: string; href?: string }[]  — the last one is the current page
 *
 * Example:
 *   <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Reports" }]} />
 */
interface Props {
  items: { label: string; href?: string }[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-500">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1.5">
          {item.href && i < items.length - 1 ? (
            <a href={item.href} class="transition-colors hover:text-slate-900">
              {item.label}
            </a>
          ) : (
            <span class="font-medium text-slate-900" aria-current="page">
              {item.label}
            </span>
          )}
          {i < items.length - 1 && <span class="text-slate-300" aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
