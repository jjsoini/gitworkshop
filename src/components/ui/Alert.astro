---
/**
 * Alert — a highlighted message box.
 *
 * Props:
 *   variant: "info" | "success" | "warning" | "error"   (default "info")
 *   title:   optional bold heading line
 *
 * Example:
 *   <Alert variant="warning" title="Heads up">Your trial ends in 3 days.</Alert>
 */
interface Props {
  variant?: 'info' | 'success' | 'warning' | 'error';
  title?: string;
  class?: string;
}
const { variant = 'info', title, class: className = '' } = Astro.props;

const variants = {
  info: { box: 'border-sky-200 bg-sky-50 text-sky-900', icon: 'text-sky-500', glyph: 'i' },
  success: { box: 'border-emerald-200 bg-emerald-50 text-emerald-900', icon: 'text-emerald-500', glyph: '✓' },
  warning: { box: 'border-amber-200 bg-amber-50 text-amber-900', icon: 'text-amber-500', glyph: '!' },
  error: { box: 'border-red-200 bg-red-50 text-red-900', icon: 'text-red-500', glyph: '×' },
};

const v = variants[variant];
---

<div class={`flex gap-3 rounded-xl border px-4 py-3 ${v.box} ${className}`} role="alert">
  <span
    class={`mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-current text-xs font-bold ${v.icon}`}
    aria-hidden="true">{v.glyph}</span
  >
  <div class="text-sm">
    {title && <p class="font-semibold">{title}</p>}
    <div class={title ? 'mt-0.5 opacity-90' : ''}><slot /></div>
  </div>
</div>
