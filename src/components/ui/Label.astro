---
/**
 * Label — a form label. Pair it with an Input via matching `for` / `id`.
 *
 * Example: <Label for="email">Email address</Label>
 */
interface Props {
  for?: string;
  class?: string;
}
const { for: htmlFor, class: className = '' } = Astro.props;
---

<label for={htmlFor} class={`block text-sm font-medium text-slate-900 ${className}`}>
  <slot />
</label>
